# Parallax backend — every variable is optional. With none set the app runs fully local
# (DuckDB engine, local JSONL memory, LLM chain rocketride→anthropic→ollama, or the fake LLM).
# Copy to backend/.env (or the repo-root .env). backend/.env wins over the repo root; real env vars win over both.

# ── modes ───────────────────────────────────────────────────────────────
PARALLAX_DATA_MODE=auto          # auto | hotdata | local
PARALLAX_LLM_MODE=auto           # auto | rocketride | anthropic | ollama | fake
PARALLAX_MEMORY_MODE=auto        # auto | cognee | local
#PARALLAX_DATA_DIR=../.parallax  # runs/, dbs/, uploads/, memory/ live here (default: <repo>/.parallax)
PARALLAX_MAX_AGENTS=16

# ── Hotdata Cloud (forked databases, BM25 + vector search) ─────────────
#HOTDATA_API_KEY=
#HOTDATA_WORKSPACE_ID=
#HOTDATA_API_URL=https://api.hotdata.dev/v1

# ── LLM providers ───────────────────────────────────────────────────────
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-5
#OLLAMA_HOST=http://localhost:11434
#OLLAMA_MODEL=llama3.1:8b
#OLLAMA_EMBED_MODEL=nomic-embed-text

# ── RocketRide (analyst reasoning pipeline) ─────────────────────────────
#ROCKETRIDE_URI=https://api.rocketride.ai      # or http://localhost:5565 for the Docker engine
#ROCKETRIDE_APIKEY=                            # local engine key: MYAPIKEY
#ROCKETRIDE_ANTHROPIC_KEY=                     # substituted into pipelines/*.pipe; falls back to ANTHROPIC_API_KEY
#ROCKETRIDE_LLM_PIPE=pipelines/parallax-llm.pipe
#ROCKETRIDE_ANALYST_PIPE=pipelines/parallax-analyst.pipe

# ── Cognee (persistent agent memory) — cognee's own config passthrough ─
#COGNEE_BASE_URL=
#LLM_PROVIDER=anthropic
#LLM_MODEL=claude-sonnet-4-5
#LLM_API_KEY=
#EMBEDDING_PROVIDER=ollama
#EMBEDDING_MODEL=nomic-embed-text:latest
#EMBEDDING_ENDPOINT=http://localhost:11434/api/embed
#EMBEDDING_DIMENSIONS=768
