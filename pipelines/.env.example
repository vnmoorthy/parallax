# RocketRide pipeline variables for Parallax.
# Copy to pipelines/.env (VS Code extension) or export in your shell / repo-root .env (backend).
# Only variables prefixed ROCKETRIDE_ are substituted into ${...} placeholders inside .pipe files.

# ── Engine ─────────────────────────────────────────────────────────────────
# Local Docker/binary engine: http://localhost:5565 with dev key MYAPIKEY.
# RocketRide Cloud: https://api.rocketride.ai with a key from https://cloud.rocketride.ai
ROCKETRIDE_URI=http://localhost:5565
ROCKETRIDE_APIKEY=MYAPIKEY

# ── LLM (llm_anthropic_1 in every pipe) ────────────────────────────────────
# Anthropic key from https://console.anthropic.com — profile claude-sonnet-4-6.
ROCKETRIDE_ANTHROPIC_KEY=sk-ant-...

# ── Hotdata (db_hotdata_1 in parallax-analyst.pipe) ────────────────────────
# API key + workspace id from https://app.hotdata.dev (Settings → API keys).
ROCKETRIDE_DB_HOTDATA_KEY=hd_...
ROCKETRIDE_DB_HOTDATA_WORKSPACE_ID=work_...

# ── Cognee (tool_cognee_1 in parallax-analyst.pipe) ────────────────────────
# Self-hosted Cognee REST server (default port 8000) or a Cognee Cloud instance URL.
# From a Dockerised engine use a host-reachable address, e.g. http://host.docker.internal:8000
ROCKETRIDE_COGNEE_BASE_URL=http://localhost:8000
# Optional for self-hosted servers with access control disabled.
ROCKETRIDE_COGNEE_API_KEY=
