# ─────────────────────────────────────────────────────────────────────────────
# Parallax environment (docs/SPEC.md §2). Copy to .env at the repo root.
# EVERYTHING IS OPTIONAL — with no keys Parallax runs fully local
# (DuckDB data engine, ollama or fake LLM, JSON memory).
# ─────────────────────────────────────────────────────────────────────────────

# ── Modes ────────────────────────────────────────────────────────────────────
# auto picks the best available backend per subsystem and falls back gracefully.
PARALLAX_DATA_MODE=auto          # auto | hotdata | local
PARALLAX_LLM_MODE=auto           # auto | rocketride | anthropic | ollama | fake
PARALLAX_MEMORY_MODE=auto        # auto | cognee | local
PARALLAX_DATA_DIR=.parallax      # runs, DuckDB files, uploads
PARALLAX_MAX_AGENTS=16

# ── Hotdata (concurrent forked databases) — sign up: https://app.hotdata.dev ─
# Settings → API keys. Workspace id looks like work_…
HOTDATA_API_KEY=
HOTDATA_WORKSPACE_ID=
HOTDATA_API_URL=https://api.hotdata.dev/v1

# ── Anthropic (direct LLM) — https://console.anthropic.com ──────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── RocketRide (pipelines / Cloud) — https://cloud.rocketride.ai ────────────
# Cloud:  ROCKETRIDE_URI=https://api.rocketride.ai + your Cloud API key
# Local:  ROCKETRIDE_URI=http://localhost:5565     + ROCKETRIDE_APIKEY=MYAPIKEY
#         (docker run --rm -p 5565:5565 ghcr.io/rocketride-org/rocketride-engine:latest)
ROCKETRIDE_URI=
ROCKETRIDE_APIKEY=
# Substituted into ${ROCKETRIDE_*} placeholders in pipelines/*.pipe.
# Falls back to ANTHROPIC_API_KEY / HOTDATA_* when empty (backend mirrors them).
ROCKETRIDE_ANTHROPIC_KEY=
ROCKETRIDE_DB_HOTDATA_KEY=
ROCKETRIDE_DB_HOTDATA_WORKSPACE_ID=
ROCKETRIDE_COGNEE_BASE_URL=http://localhost:8000
ROCKETRIDE_COGNEE_API_KEY=

# ── Ollama (local LLM + embeddings, optional) ────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Cognee (persistent agent memory) — https://docs.cognee.ai ───────────────
# Cognee needs BOTH an LLM and an embedding provider. Defaults below: Anthropic LLM
# (reuses ANTHROPIC_API_KEY) + ollama nomic-embed-text embeddings (768 dims).
# Fully local alternative: LLM_PROVIDER=ollama LLM_MODEL=llama3.1:8b LLM_ENDPOINT=http://localhost:11434
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
LLM_API_KEY=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_ENDPOINT=http://localhost:11434/api/embed
EMBEDDING_DIMENSIONS=768
COGNEE_BASE_URL=http://localhost:8000
ENABLE_BACKEND_ACCESS_CONTROL=false
TELEMETRY_DISABLED=true

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
